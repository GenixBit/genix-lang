fn add(a: int, b: int) -> int {
    return a + b;
}

fn average(a: float, b: float) -> float {
    return (a + b) / 2.0;
}

fn greet(name: string) {
    print("Hello " + name);
}

fn classify(value: int) -> string {
    if value >= 10 {
        return "large";
    } else {
        return "small";
    }
}

fn main() {
    let total: int = add(10, 20);
    let avg: float = average(10, 20);
    let label: string = classify(total);

    greet("GenixBit");
    print(total);
    print(avg);
    print(label);
}
